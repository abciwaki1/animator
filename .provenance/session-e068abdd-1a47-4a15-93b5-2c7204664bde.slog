{"data":{"content":"pub fn update(model: Model, msg: Msg) -> #(Model, Effect(Msg)) {\n  case msg {\n    SetDrawing(name) -> {\n      case name {\n        \"default\" ->\n          update(model, SetCode(default_code))\n\n        _ ->\n          case list.key_find(examples.all, name, 0) {\n            Ok(#(_, source)) ->\n              update(model, SetCode(source))\n\n            Error(_) ->\n              #(model, effect.none())\n          }\n      }\n    }\n\n    SetShape(text) -> {","length":448,"path":"src/app.gleam","range":{"end":{"character":4,"line":96},"start":{"character":4,"line":96}},"sha256":"8e41365138c5e1b12a9713469384fe39e3ecae4841ebaceccf8246a260571c09"},"hash":"20aee728bd89ae1b741f4de13d9055b3d5d812a7ccaa0171a13e1d38dbc5b3aa","kind":"paste","prev_hash":"a53901395e2d7e35d98ce0a6f7953771f1d3912a1b7bb585f9601d60cbe04c5d","seq":12053,"t":184746504,"wall":"2026-11-21T02:41:22.693Z"}
