{"data":{"content":"SetSpeed(text) -> {\n  let value = result.unwrap(int.parse(text), model.speed_value)\n  let rate = int.to_float(value) /. 50.0\n\n  #(\n    Model(..model, speed_value: value),\n    effect.from(fn(_dispatch) {\n      render.set_speed(rate)\n    }),\n  )\n}","length":245,"path":"src/app.gleam","range":{"end":{"character":4,"line":110},"start":{"character":4,"line":110}},"sha256":"bda18e07040d212f9db82c4a66a8c8f19c05805dff1c57bbd3d25181bd06b3fc"},"hash":"8e039adc815e5faafeb38deaf14cc82703ff6db3377a517724c4fb4080ae8236","kind":"paste","prev_hash":"b4a1e888a27ce24854b4fcb86bdcd8cc09aed5667fc4c5641e00281591d1ab20","seq":11018,"t":182541919,"wall":"2026-11-21T02:04:38.106Z"}
