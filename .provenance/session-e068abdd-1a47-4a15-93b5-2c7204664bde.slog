.code-runner","version":"0.12.2"},{"enabled":true,"id":"itsgeagle.provenance-recorder","version":"2.0.2"},{"enabled":false,"id":"ms-python.debugpy","version":"2026.6.0"},{"enabled":false,"id":"ms-python.python","version":"2026.10.0"},{"enabled":false,"id":"ms-python.vscode-pylance","version":"2026.4.1"},{"enabled":false,"id":"ms-vscode.cmake-tools","version":"1.25.10"},{"enabled":false,"id":"ms-vscode.cpp-devtools","version":"0.7.2"},{"enabled":false,"id":"ms-vscode.cpptools","version":"1.35.6"},{"enabled":false,"id":"ms-vscode.cpptools-extension-pack","version":"1.5.1"},{"enabled":false,"id":"ms-vscode.cpptools-themes","version":"2.0.0"},{"enabled":true,"id":"shardulm94.trailing-spaces","version":"0.4.4"},{"enabled":false,"id":"twxs.cmake","version":"0.0.17"}]},"hash":"e8a317465ec7cdac4a2275675e8ba65cc85fac58467b9e86990b9b2bc69f6cea","kind":"ext.snapshot","prev_hash":"7ad6310799331194f80ca363ca3a38956e4a5805c3c3680f4548fa0e4960206c","seq":9543,"t":173200371,"wall":"2026-11-20T23:28:56.597Z"}
