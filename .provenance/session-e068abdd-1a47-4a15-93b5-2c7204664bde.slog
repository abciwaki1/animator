{"data":{"content":"SetShape(text) -> {\n  let value = result.unwrap(int.parse(text), model.shape_value)\n\n  case run_source(value, model.source) {\n    Ok(paths) ->\n      #(\n        Model(..model, shape_value: value, output: string.inspect(paths)),\n        effect.none(),\n      )\n\n    Error(msg) ->\n      #(\n        Model(..model, shape_value: value, output: msg),\n        effect.none(),\n      )\n  }\n}","length":379,"path":"src/app.gleam","range":{"end":{"character":4,"line":90},"start":{"character":4,"line":90}},"sha256":"58f8836e42e423b9143b0fea919d30f3cfb5bbb0ac1eeaa415226c06d8d424f2"},"hash":"1a198cc9fd6b4d4e2beab65e0a53e4d229b9460839af8fe61abf58b7c6f366b4","kind":"paste","prev_hash":"88f957faff1f2adfd573e51f53127d0dc8690747a3ff4a549cb88ec47e065795","seq":10484,"t":178443546,"wall":"2026-11-21T00:56:19.664Z"}
