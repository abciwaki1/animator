{"data":{"content":"\"default\" -> {\n  let #(new_model, draw_effect) = update(model, SetCode(default_code))\n  #(\n    new_model,\n    effect.batch([draw_effect, editor.mount(default_code, SetCode)]),\n  )\n}\n\n_ ->\n  case list.key_find(examples.all, name, 0) {\n    Ok(#(_, source)) -> {\n      let #(new_model, draw_effect) = update(model, SetCode(source))\n      #(\n        new_model,\n        effect.batch([draw_effect, editor.mount(source, SetCode)]),\n      )\n    }","length":438,"path":"src/app.gleam","range":{"end":{"character":8,"line":99},"start":{"character":8,"line":99}},"sha256":"31215b0ad10e76b258ec7309fa0b5a6db8d2055a3f9c485ba6d98aac170055c7"},"hash":"e079f5a90cec1c962156ca856d86a0b26cb3583456148082ec5f00600267ccf4","kind":"paste","prev_hash":"eb3f9ee3f4c437813cb8dd1293625fe8fc734244779e7fc6264ab1db6a0f9a9f","seq":12298,"t":185206230,"wall":"2026-11-21T02:49:02.416Z"}
